{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nve.storyboard/1",
  "title": "nve storyboard",
  "description": "The single source of truth for one video. All times in tracks.overlay and tracks.audio are on the OUTPUT timeline (after cuts and speed). tracks.video times are SOURCE times.",
  "type": "object",
  "required": [
    "schema",
    "template",
    "cut_strategy",
    "output",
    "sources",
    "tracks"
  ],
  "properties": {
    "schema": {
      "const": "nve.storyboard/1"
    },
    "project": {
      "type": "string"
    },
    "template": {
      "type": "string",
      "pattern": "^(core|pro|user):[a-z0-9][a-z0-9._-]*(@\\^?\\d+(\\.\\d+)*)?$"
    },
    "cut_strategy": {
      "enum": [
        "speech",
        "visual",
        "beat",
        "hybrid"
      ]
    },
    "brief": {
      "type": "string"
    },
    "output": {
      "type": "object",
      "required": [
        "width",
        "height",
        "fps"
      ],
      "properties": {
        "aspect": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "minimum": 16
        },
        "height": {
          "type": "integer",
          "minimum": 16
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "speed": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 4
        },
        "platform": {
          "type": "string"
        },
        "flip": {
          "type": "boolean",
          "description": "mirror horizontally (front camera)"
        }
      }
    },
    "style": {
      "type": "object"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "path": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "video",
              "image",
              "audio"
            ]
          },
          "transcript": {
            "type": "string"
          },
          "audio": {
            "enum": [
              "keep",
              "mute"
            ],
            "description": "mute = drop this clip's own sound (noisy clip without speech); music/SFX carry the audio"
          }
        }
      }
    },
    "tracks": {
      "type": "object",
      "required": [
        "video"
      ],
      "properties": {
        "video": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "src",
              "in",
              "out"
            ],
            "properties": {
              "src": {
                "type": "string"
              },
              "in": {
                "type": "number",
                "minimum": 0
              },
              "out": {
                "type": "number",
                "minimum": 0
              },
              "speed": {
                "type": "number"
              },
              "note": {
                "type": "string"
              },
              "mute": {
                "type": "boolean"
              }
            }
          }
        },
        "overlay": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "block",
              "start",
              "end"
            ],
            "properties": {
              "block": {
                "type": "string"
              },
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              },
              "props": {
                "type": "object"
              },
              "sfx": {
                "type": "array"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "audio": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "asset"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "bgm",
                  "sfx",
                  "voice"
                ]
              },
              "asset": {
                "type": "string"
              },
              "at": {
                "type": "number",
                "minimum": 0
              },
              "volume": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              }
            }
          }
        }
      }
    },
    "text_fixes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "engines": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "gates": {
      "type": "object"
    },
    "cover": {
      "type": "object",
      "description": "Cover image (thumbnail). Rendered at output time `at` without captions/cards, with `text` as a big title.",
      "required": [
        "text",
        "at"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "at": {
          "type": "number",
          "minimum": 0
        },
        "emoji": {
          "type": "array"
        },
        "alt": {
          "type": "boolean"
        },
        "top": {
          "type": "number"
        },
        "scale": {
          "type": "number"
        },
        "prepend": {
          "type": "boolean",
          "description": "also put the cover at the start of the video"
        },
        "seconds": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 3
        }
      }
    }
  }
}
